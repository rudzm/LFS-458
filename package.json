{
  "name": "lfs458-materials",
  "version": "1.0.0",
  "private": true,
  "description": "LFS458 — materiały szkoleniowe: slajdy (marp) i laby",
  "scripts": {
    "slides": "marp --config-file .marprc.yml --pdf --pdf-outlines --allow-local-files -I slides -o build/pdf",
